{
  "name": "bilbypixel/bilbydugout-api",
  "description": "BilbyDugout (BilbyPixel Request Portal) — SlimPHP API",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "illuminate/database": "^11.0",
    "illuminate/events": "^11.0",
    "firebase/php-jwt": "^6.10",
    "vlucas/phpdotenv": "^5.6",
    "guzzlehttp/guzzle": "^7.9",
    "robmorgan/phinx": "^0.16",
    "monolog/monolog": "^3.7",
    "respect/validation": "^2.3",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8080 -t public",
    "migrate": "phinx migrate -c phinx.php",
    "rollback": "phinx rollback -c phinx.php",
    "seed": "phinx seed:run -c phinx.php",
    "test": "phpunit",
    "stan": "phpstan analyse src --level=5"
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0,
    "policy": {
      "advisories": {
        "block": false
      }
    }
  }
}
