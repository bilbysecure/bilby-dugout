# ── App ────────────────────────────────────────────────────────────────
APP_ENV=local                 # local | production
APP_DEBUG=true
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated SPA origins

# ── Database (MySQL / MariaDB) ─────────────────────────────────────────
# A MySQL 8.0+ or MariaDB 11.x server is required. `docker compose up db`
# starts one matching the defaults below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bilbydugout
DB_USERNAME=bilby
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── App JWT (firebase/php-jwt) ─────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=bilbydugout
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)

# ── Azure AD (OAuth2 — ROPC password grant) ────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
# Login flow: 'ropc' (form -> Axios -> Slim -> Azure) or 'authcode' (PKCE fallback)
AUTH_FLOW=ropc

# ── Microsoft Graph (application permissions, Phase 3) ─────────────────
GRAPH_SERVICE_MAILBOX=requests@bilbypixel.com

# ── Stripe (Phase 3) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── LLM: Anthropic Claude API (Phase 3) ────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6   # claude-opus-4-8 available for heavier tasks
